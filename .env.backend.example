# Set these only on the analysis hosting service, never as VITE_ variables.
NODE_ENV=production
AI_ENABLED=true
AI_DEMO_MODE=false
AI_HOST=0.0.0.0
# Most platforms provide PORT automatically. Leave AI_PORT unset on those platforms.
AI_DATA_DIR=/data
AI_ALLOWED_ORIGINS=https://simplyarticulate.com,https://www.simplyarticulate.com
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY
ASSEMBLYAI_API_KEY=YOUR-ASSEMBLYAI-KEY
GEMINI_API_KEY=YOUR-GEMINI-KEY
ASSEMBLYAI_MODEL=universal-3-5-pro
GEMINI_MODEL=gemini-3.5-flash-lite
