{
  "name": "topic-voice-practice",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server/dev.js",
    "build": "vite build",
    "preview": "node server/dev.js --preview",
    "ai:server": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.server.local server/index.js",
    "ai:demo": "node server/demo.js",
    "test:ai": "node --test server/*.test.js",
    "ai:dictate": "node --env-file-if-exists=.env.server.local server/dictate-microphone.js",
    "ai:dictation-check": "node --env-file-if-exists=.env.server.local server/dictate-microphone.js --check",
    "dev:frontend": "vite",
    "ai:check": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.server.local server/check-config.js",
    "test": "node --test server/*.test.js src/lib/*.test.js scripts/*.test.js",
    "build:netlify": "npm run test && node scripts/build-netlify.js",
    "deployment:check": "node scripts/check-deployment.js",
    "deployment:check:online": "node scripts/check-deployment.js --online",
    "deployment:check:backend": "node scripts/check-deployment.js --backend",
    "start": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.server.local server/index.js",
    "supabase:prepare": "node scripts/prepare-supabase.js",
    "supabase:export": "node scripts/export-local-supabase.js"
  },
  "dependencies": {
    "@supabase/server": "1.8.1",
    "@supabase/supabase-js": "2.117.2",
    "@vitejs/plugin-react": "6.1.1",
    "assemblyai": "4.41.5",
    "node-record-lpcm16": "1.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "@electric-sql/pglite": "0.5.8"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
